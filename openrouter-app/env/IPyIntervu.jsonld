        "  - businessDomain (object containing companyName and domain, received from ConceptualUnderstandingMode)",
        "  - bugAssessmentBucket",
        "  - bugSnippet",
        "  - intendedBehaviorDescription",
        "  - userDebuggingDescriptions",
        "  - assessmentNotes",
        "  - waitingForUserResponse",
        "  - pendingQuestion",
        "AssessmentAggregatorActor (as it pertains to this mode):",
        "  - bugAssessmentBuckets (map: concept -> bucket)"
      ],
      "readableBy": [
        "ex:BugPersona1",
        "ex:BugPersona2",
        "ex:AssessmentAggregatorPersona"
      ],
      "unreadableBy": [
        "ex:ConceptPersona1",
        "ex:ConceptPersona2",
        "ex:CodePersona1",
        "ex:CodePersona2",
        "ex:CoachingPersona1",
        "ex:CoachingPersona2"
      ]
    },
    {
      "@id": "ex:CoachingModeState",
      "@type": "IsolatedState",
      "mode": "ex:CoachingMode",
      "scope": "private to CoachingMode actors",
      "includes": [
        "CoachingActor1 state:",
        "  - studentMajor",
        "  - currentConcept",
        "  - currentWeekNumber",
        "  - conceptualAssessmentBucket (copied from Aggregator)",
        "  - codeAssessmentBucket (copied from Aggregator)",
        "  - bugAssessmentBucket (copied from Aggregator)",
        "  - finalRating (Not Ready Yet, Competent, Exceptional)",
        "  - feedbackNotes (bullet-point notes on strengths and growth areas)",
        "  - waitingForUserResponse",
        "  - pendingQuestion",
        "CoachingActor2 state:",
        "  - studentMajor",
        "  - currentConcept",
        "  - currentWeekNumber",
